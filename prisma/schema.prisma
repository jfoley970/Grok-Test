generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  owner
  service_writer
}

enum ListingStatus {
  active
  reserved
  sold
}

enum OrderStatus {
  pending
  paid
  cancelled
}

model Shop {
  id               String   @id @default(cuid())
  name             String   @unique
  cityRegion       String
  phone            String?
  stripeAccountId  String?
  chargesEnabled   Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              User[]
  listings           Listing[]
  buyOrders          Order[]      @relation("BuyerShop")
  sellOrders         Order[]      @relation("SellerShop")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole
  shopId       String
  shop         Shop     @relation(fields: [shopId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listingsPosted Listing[] @relation("PostedBy")
  ordersPlaced   Order[]   @relation("PlacedBy")
}

model Listing {
  id              String        @id @default(cuid())
  title           String
  brand           String
  partNumber      String
  condition       String
  make            String
  model           String
  year            Int
  fitmentNotes    String
  quantity        Int           @default(1)
  priceCents      Int
  shippingNotes   String?
  status          ListingStatus @default(active)
  shopId          String
  shop            Shop          @relation(fields: [shopId], references: [id])
  postedByUserId  String
  postedBy        User          @relation("PostedBy", fields: [postedByUserId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  orders Order[]
  photos ListingPhoto[]
}

model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Order {
  id                    String      @id @default(cuid())
  listingId             String
  listing               Listing     @relation(fields: [listingId], references: [id])
  buyerShopId           String
  buyerShop             Shop        @relation("BuyerShop", fields: [buyerShopId], references: [id])
  sellerShopId          String
  sellerShop            Shop        @relation("SellerShop", fields: [sellerShopId], references: [id])
  placedByUserId        String
  placedBy              User        @relation("PlacedBy", fields: [placedByUserId], references: [id])
  amountCents           Int
  status                OrderStatus @default(pending)
  stripeCheckoutSession String?
  stripePaymentIntent   String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}
